# Server Configuration
PORT=3001

# CORS origin for the client (default for local dev)
CORS_ORIGIN=http://localhost:5173

# Room expiration time in milliseconds (default: 15 minutes)
ROOM_EXPIRATION_MS=900000

# ICE servers configuration (for client, exposed via config endpoint)
# Format: JSON array of RTCIceServer objects
# Default uses public Google STUN servers
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]
